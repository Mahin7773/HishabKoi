%%{init: {'theme':'base','themeVariables':{'primaryColor':'#FFFFFF','primaryBorderColor':'#5F6368','primaryTextColor':'#2E2E2E','lineColor':'#6B6B6B','textColor':'#2E2E2E','edgeLabelBackground':'#FFFFFF','clusterBkg':'#FFFFFF','clusterBorder':'#8A8A8A','fontFamily':'Segoe UI, Arial','fontSize':'40px'}, 'flowchart':{'wrappingWidth':360,'nodeSpacing':20,'rankSpacing':35,'padding':18,'diagramPadding':8,'subGraphTitleMargin':{'top':6,'bottom':40}}}}%%
flowchart TD
    A([Open HishabKoi]) --> B{Logged in?}
    B -- No --> C[Log in / Sign up]
    C --> D
    B -- Yes --> D[Home]

    D --> PS
    D --> W

    subgraph PS [Personal - offline]
        direction TB
        P1[Add transaction] ~~~ P2[Transactions]
        P1 --> P3[Reports]
        P1 ~~~ P4[Categories]
    end

    subgraph W [Friends - online]
    direction LR
    subgraph FS [Requests]
        direction TB
        F1[Borrow / Repay<br/>request] --> F2{Accepted?}
        F2 -- No --> F5[History]
        F2 -- Yes --> F3[Balances updated]
        F3 --> F5
    end

    FS -- loop found --> LP

    subgraph LP [Circular settle]
        direction TB
        L1[Proposal to all] --> L2{All agree?}
        L2 -- Yes --> L3[Smallest debt<br/>cancelled]
        L2 -- No --> L4[No change]
    end
    end

    classDef default fill:#F4F4F2,stroke:#5F6368,stroke-width:2px,color:#2E2E2E,font-size:40px
    classDef personal fill:#E6EBF0,stroke:#5E7183,stroke-width:2px,color:#2F3B46
    classDef friends fill:#EEE9E3,stroke:#7D7064,stroke-width:2px,color:#3D352E
    classDef loop fill:#E5ECE7,stroke:#617468,stroke-width:2px,color:#2F3A33
    class P1,P2,P3,P4 personal
    class F1,F2,F3,F5 friends
    class L1,L2,L3,L4 loop
    style W fill:#FAF9F7,stroke:#7D7064,stroke-width:2px
    style PS fill:#F5F7F9,stroke:#5E7183,stroke-width:2px
    style FS fill:#F7F4F0,stroke:#9A8E82,stroke-width:1.5px
    style LP fill:#F2F6F3,stroke:#7F9186,stroke-width:1.5px
