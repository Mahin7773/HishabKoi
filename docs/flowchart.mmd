flowchart TD
    A([Open HishabKoi]) --> B{Logged in?}
    B -- No --> C[Log in / Sign up<br/>email + @username]
    C --> D
    B -- Yes --> D[Home<br/>balance, stats, debts]

    D --> PS
    D --> W

    subgraph PS [Personal - this phone only]
        direction TB
        P1[Add expense / income] --> P2[Transactions]
        P1 --> P3[Reports<br/>bars + donut]
        P1 ~~~ P4[Manage categories]
    end

    subgraph W [Friends - synced online]
    direction LR
    subgraph FS [Requests]
        direction TB
        F1[Borrow / Pay back<br/>request to @username] --> F2{Accepted?}
        F2 -- No --> F5[History]
        F2 -- Yes --> F3[Balances + wallet<br/>updated]
        F3 --> F5
    end

    FS -- debt loop found --> LP

    subgraph LP [Circular settle]
        direction TB
        L1[Proposal sent<br/>to every member] --> L2{All agree?}
        L2 -- Yes --> L3[Smallest debt cancelled<br/>around the loop]
        L2 -- No --> L4[Balances unchanged]
    end
    end

    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000,font-size:34px
