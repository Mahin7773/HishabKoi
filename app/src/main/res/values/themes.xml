<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 DayNight with a fixed brand-blue scheme. Wallpaper-based dynamic colour is
         deliberately off, so every default control matches the brand colours on any phone. -->
    <style name="Base.Theme.HishabKoi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/seed_primary</item>
        <item name="colorOnPrimary">@color/seed_on_primary</item>
        <item name="colorPrimaryContainer">@color/seed_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/seed_on_primary_container</item>
        <item name="colorSecondary">@color/seed_secondary</item>
        <item name="colorOnSecondary">@color/seed_on_secondary</item>
        <item name="colorSecondaryContainer">@color/seed_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/seed_on_secondary_container</item>
        <item name="colorTertiary">@color/seed_tertiary</item>
        <item name="colorSurface">@color/seed_surface</item>
        <item name="colorOnSurface">@color/seed_on_surface</item>
        <item name="colorSurfaceVariant">@color/seed_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/seed_on_surface_variant</item>
        <item name="colorOutline">@color/seed_outline</item>
        <item name="colorOutlineVariant">@color/seed_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/seed_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/seed_container_low</item>
        <item name="colorSurfaceContainer">@color/seed_container</item>
        <item name="colorSurfaceContainerHigh">@color/seed_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/seed_container_highest</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.HishabKoi.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.HishabKoi.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.HishabKoi.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.HishabKoi.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.HishabKoi.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.HishabKoi.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.HishabKoi.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.HishabKoi.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.HishabKoi.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.HishabKoi.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.HishabKoi.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.HishabKoi.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.HishabKoi.LabelSmall</item>
        <item name="materialButtonStyle">@style/Widget.HishabKoi.Button</item>
        <item name="toolbarStyle">@style/Widget.HishabKoi.Toolbar</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.HishabKoi.Button.Outlined</item>
        <item name="textInputOutlinedStyle">@style/Widget.HishabKoi.TextField</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.HishabKoi.Dialog</item>
    </style>

    <!-- Dialogs: solid white card (navy in dark mode), bold title, and the confirming action as
         a solid brand-blue button so it reads like the main buttons everywhere else. -->
    <style name="ThemeOverlay.HishabKoi.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/glass_chip</item>
        <item name="materialAlertDialogTitleTextStyle">@style/HishabKoi.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.HishabKoi.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.HishabKoi.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.HishabKoi.DialogButton</item>
    </style>

    <style name="HishabKoi.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="Widget.HishabKoi.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/tile_local_icon</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.HishabKoi.DialogButton.Positive" parent="Widget.HishabKoi.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="backgroundTint">@color/brand_button_bg</item>
        <item name="android:textColor">@color/brand_button_fg</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Theme.HishabKoi" parent="Base.Theme.HishabKoi" />

    <style name="TextAppearance.HishabKoi.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.HishabKoi.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.HishabKoi.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <style name="TextAppearance.HishabKoi.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.HishabKoi.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.HishabKoi.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="HishabKoi.SectionHeader" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- App name next to the logo in the home top bar. -->
    <style name="TextAppearance.HishabKoi.ToolbarBrand" parent="TextAppearance.HishabKoi.TitleLarge">
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Buttons: rectangular-ish (12dp corners) everywhere. The theme points every <Button>,
         outlined button and outlined text field at these, so all screens share one shape. -->
    <style name="Widget.HishabKoi.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.HishabKoi.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.HishabKoi.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Main action of a form: taller, bigger label. -->
    <style name="Widget.HishabKoi.Button.Large">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <!-- Main auth action in the fixed brand blue, matching the logo and the wallet card. -->
    <style name="Widget.HishabKoi.Button.Brand" parent="Widget.HishabKoi.Button.Large">
        <item name="backgroundTint">@color/brand_button_bg</item>
        <item name="android:textColor">@color/brand_button_fg</item>
        <item name="iconTint">@color/brand_button_fg</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Secondary action: a solid white chip with a blue edge, so it stands out on the tinted
         page and on glass panels while staying quieter than the solid main button. -->
    <style name="Widget.HishabKoi.Button.Secondary" parent="Widget.HishabKoi.Button.Outlined">
        <item name="backgroundTint">@color/glass_chip</item>
        <item name="android:textColor">@color/tile_local_icon</item>
        <item name="iconTint">@color/tile_local_icon</item>
        <item name="strokeColor">@color/panel_local_stroke</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Same, in the With friends indigo. -->
    <style name="Widget.HishabKoi.Button.Secondary.Synced">
        <item name="android:textColor">@color/tile_synced_icon</item>
        <item name="iconTint">@color/tile_synced_icon</item>
        <item name="strokeColor">@color/panel_synced_stroke</item>
    </style>

    <!-- Secondary auth action, as tall as the main button next to it. -->
    <style name="Widget.HishabKoi.Button.Accent" parent="Widget.HishabKoi.Button.Secondary">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

    <!-- Main action inside a list card (Accept, Agree, Propose). Every such card is on a With
         friends screen, so it uses the same solid indigo as "Send request". -->
    <style name="Widget.HishabKoi.Button.Small">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="backgroundTint">@color/synced_button_bg</item>
        <item name="android:textColor">@color/synced_button_fg</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Second action inside a list card (Decline, Reject): the same light-red pill as Delete
         and Cancel request, so every "say no" button looks alike. -->
    <style name="Widget.HishabKoi.Button.Outlined.Small" parent="Widget.HishabKoi.Button.Tonal">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="backgroundTint">@color/delete_bg</item>
        <item name="android:textColor">@color/solid_red</item>
    </style>

    <style name="Widget.HishabKoi.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/tile_local_icon</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <!-- Small destructive action under a list card's amount (Delete, Cancel, Reject):
         a light-red pill so it reads as a button, not stray text. -->
    <style name="Widget.HishabKoi.Button.Text.Inline" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="backgroundTint">@color/delete_bg</item>
        <item name="android:textColor">@color/solid_red</item>
        <item name="iconTint">@color/solid_red</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="Widget.HishabKoi.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <!-- Same solid chip colour as secondary buttons: white, or navy in dark mode. -->
        <item name="boxBackgroundColor">@color/glass_chip</item>
        <item name="startIconTint">?attr/colorPrimary</item>
    </style>

    <!-- Fields stacked in the auth form card. -->
    <style name="Widget.HishabKoi.TextField.Form">
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Widget.HishabKoi.FormCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Local section form controls: section colour, solid when selected. -->
    <style name="Widget.HishabKoi.Toggle.Local" parent="Widget.HishabKoi.Button.Outlined">
        <item name="backgroundTint">@color/toggle_local_bg</item>
        <item name="android:textColor">@color/toggle_local_fg</item>
        <item name="strokeColor">@color/tile_local_icon</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="Widget.HishabKoi.Chip.Local" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_local_bg</item>
        <item name="android:textColor">@color/toggle_local_fg</item>
        <item name="checkedIconTint">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">10dp</item>
    </style>

    <style name="Widget.HishabKoi.Button.Outlined.Local">
        <item name="strokeColor">@color/panel_local_stroke</item>
        <item name="android:textColor">@color/tile_local_icon</item>
        <item name="iconTint">@color/tile_local_icon</item>
    </style>

    <!-- Synced section form controls: section colour, solid when selected. -->
    <style name="Widget.HishabKoi.Toggle.Synced" parent="Widget.HishabKoi.Button.Outlined">
        <item name="backgroundTint">@color/toggle_synced_bg</item>
        <item name="android:textColor">@color/toggle_synced_fg</item>
        <item name="strokeColor">@color/tile_synced_icon</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <style name="Widget.HishabKoi.Chip.Synced" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_synced_bg</item>
        <item name="android:textColor">@color/toggle_synced_fg</item>
        <item name="checkedIconTint">@color/on_solid</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">10dp</item>
    </style>

    <style name="Widget.HishabKoi.Button.Outlined.Synced">
        <item name="strokeColor">@color/panel_synced_stroke</item>
        <item name="android:textColor">@color/tile_synced_icon</item>
        <item name="iconTint">@color/tile_synced_icon</item>
    </style>

    <style name="Widget.HishabKoi.Button.Synced" parent="Widget.HishabKoi.Button.Large">
        <item name="backgroundTint">@color/synced_button_bg</item>
        <item name="android:textColor">@color/synced_button_fg</item>
        <item name="iconTint">@color/synced_button_fg</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Form panel on Add entry / Borrow / Pay back: same look as the home section panels. -->
    <style name="Widget.HishabKoi.FormPanel" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">28dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="contentPaddingLeft">14dp</item>
        <item name="contentPaddingRight">14dp</item>
        <item name="contentPaddingTop">8dp</item>
        <item name="contentPaddingBottom">16dp</item>
    </style>

    <!-- Toolbars: round two-colour nav/menu buttons keep their own colours; bold titles. -->
    <style name="Widget.HishabKoi.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="navigationIconTint">@null</item>
        <item name="titleTextAppearance">@style/TextAppearance.HishabKoi.ToolbarBrand</item>
        <item name="titleMarginStart">12dp</item>
    </style>

    <!-- Frosted panel: translucent fill, bright hairline edge, no shadow. -->
    <style name="Widget.HishabKoi.Glass" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardCornerRadius">28dp</item>
    </style>
</resources>
