<?xml version="1.0" encoding="utf-8"?>
<!-- Home feature: a frosted icon chip with its label underneath, count badge on the chip's corner.
     No card of its own; it sits straight on the section panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:background="@drawable/bg_tile_ripple"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="0dp">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:elevation="2dp"
            android:importantForAccessibility="no"
            android:padding="15dp" />

        <!-- Up to two lines, like "Who owes / whom"; a row of one-line labels stays short. -->
        <TextView
            android:id="@+id/tile_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:letterSpacing="0"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:textFontWeight="600" />
    </LinearLayout>

    <TextView
        android:id="@+id/tile_badge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_badge"
        android:elevation="3dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="20dp"
        android:paddingHorizontal="6dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnError"
        android:visibility="gone" />
</FrameLayout>
